{
  "name": "Alien Watch",
  "site": "https://alienwatch.buzz/",
  "language": "en",
  "postproxy": {
    "profileGroupId": "AnFA46",
    "profileIds": [
      "DaUWBa",
      "j3Ulwd",
      "mxU8Vn"
    ]
  },
  "autopilot": {
    "mode": "draft",
    "dms": false,
    "maxPerRun": 10,
    "skipAuthors": [
      "alienwtch",
      "alienwatch"
    ],
    "escalateWords": [
      "legal",
      "lawyer",
      "refund",
      "press",
      "journalist",
      "lawsuit",
      "copyright",
      "dmca",
      "partnership",
      "sponsor"
    ],
    "agent": {
      "command": [
        "claude",
        "-p",
        "--output-format",
        "json"
      ],
      "timeoutMs": 120000
    }
  },
  "handles": {
    "twitter": "@alienwtch",
    "instagram": "@alienwatch"
  },
  "notes": "UFO/UAP observations log, six languages. Social copy is English only.",
  "feed": {
    "url": "https://alienwatch.buzz/feed/v1/briefings?lang=en&limit=10",
    "items": "data",
    "fields": {
      "title": "title",
      "dek": "dek",
      "section": "sector.name",
      "date": "storyDate",
      "image": "imageUrl",
      "slug": "slug",
      "sources": "sourceCount",
      "languages": "languageCount"
    },
    "imageRewrite": {
      "match": "^.*?/api/assets/tenants/[0-9a-f-]+/",
      "replace": "https://alienwatch.buzz/assets/"
    },
    "storyUrl": "https://alienwatch.buzz/#/b/{slug}?lang=en",
    "displayUrl": "alienwatch.buzz"
  },
  "social": {
    "platforms": [
      "tiktok"
    ]
  },
  "daily": {
    "slots": [
      "14:00",
      "19:00"
    ],
    "tz": "Z",
    "maxAgeHours": 72,
    "only": [
      "instagram_reel",
      "tiktok"
    ]
  }
}
