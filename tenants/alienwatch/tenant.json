{
  "name": "Alien Watch",
  "site": "https://alienwatch.buzz/",
  "language": "en",
  "postproxy": {
    "profileGroupId": "AnFA46",
    "profileIds": [
      "DaUWBa",
      "j3Ulwd",
      "mxU8Vn"
    ]
  },
  "autopilot": {
    "mode": "draft",
    "dms": false,
    "maxPerRun": 10,
    "skipAuthors": [
      "alienwtch",
      "alienwatch"
    ],
    "escalateWords": [
      "legal",
      "lawyer",
      "refund",
      "press",
      "journalist",
      "lawsuit",
      "copyright",
      "dmca",
      "partnership",
      "sponsor"
    ],
    "agent": {
      "command": [
        "claude",
        "-p",
        "--output-format",
        "json"
      ],
      "timeoutMs": 120000
    },
    "jev": true
  },
  "handles": {
    "twitter": "@alienwtch",
    "instagram": "@alienwatch"
  },
  "notes": "UFO/UAP observations log, six languages. Social copy is English only.",
  "feed": {
    "url": "https://alienwatch.buzz/feed/v1/briefings?lang=en&limit=50",
    "items": "data",
    "fields": {
      "title": "title",
      "dek": "dek",
      "section": "sector.name",
      "date": "storyDate",
      "image": "imageUrl",
      "slug": "slug",
      "sources": "sourceCount",
      "languages": "languageCount"
    },
    "imageRewrite": {
      "match": "^.*?/api/assets/tenants/[0-9a-f-]+/",
      "replace": "https://alienwatch.buzz/assets/"
    },
    "storyUrl": "https://alienwatch.buzz/#/b/{slug}?lang=en",
    "displayUrl": "alienwatch.buzz"
  },
  "social": {
    "platforms": [
      "tiktok"
    ]
  },
  "daily": {
    "slots": [
      "07:00",
      "09:00",
      "16:00",
      "21:00"
    ],
    "tz": "+01:00",
    "maxAgeHours": 72,
    "only": [
      "instagram_reel",
      "tiktok"
    ],
    "freshness": "archive",
    "round": {
      "times": [
        "07:00",
        "09:00",
        "12:30",
        "16:00",
        "18:30",
        "21:00",
        "23:30"
      ],
      "gapMinutes": 85
    }
  },
  "music": {
    "prompt": "Instrumental sci-fi news jingle for Alien Watch, a UFO and UAP news brand. Mysterious and cinematic: a memorable three-note theremin-like synth motif opens the track and returns, pulsing analog arpeggio, deep sub bass, airy pads, subtle glitchy percussion, 100 BPM, minor key. Tense but not scary, it sits under on-screen text. No vocals, it ends on a clean resolving hit.",
    "seconds": 30
  },
  "casefile": {
    "enabled": true,
    "mode": "alternate",
    "ratio": {
      "news": 1,
      "casefile": 1
    },
    "sources": []
  }
}
