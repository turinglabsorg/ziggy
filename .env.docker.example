# copy to .env.docker and fill in — the file is gitignored, never commit the real one
# one Postproxy key per tenant (the slug uppercased); never the shared POSTPROXY_API_KEY
POSTPROXY_API_KEY_RAGUSA=
POSTPROXY_API_KEY_ALIENWATCH=
# `claude -p` writes the reel summaries (tenant.json → feed.agent); without it the
# daily loop falls back to splitting the story dek into slides
ANTHROPIC_API_KEY=
# the report goes to Telegram once per cycle via docker/telegram-notify.mjs
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# health endpoint port (also the published port in docker-compose.yml)
ZIGGY_SERVE_PORT=8080
