{
  "name": "Ragusa Buzz",
  "site": "https://ragusa.buzz/",
  "language": "it",
  "postproxy": {
    "profileGroupId": "NWFp3R",
    "profileIds": [
      "OLU4ab"
    ]
  },
  "autopilot": {
    "mode": "draft",
    "dms": false,
    "maxPerRun": 10,
    "skipAuthors": [
      "ragusabuzz"
    ],
    "escalateWords": [
      "legal",
      "lawyer",
      "avvocato",
      "denuncia",
      "querela",
      "diffamazione",
      "press",
      "journalist",
      "giornalista",
      "sponsor",
      "partnership",
      "soldi",
      "refund"
    ],
    "agent": {
      "command": [
        "claude",
        "-p",
        "--output-format",
        "json"
      ],
      "timeoutMs": 120000
    }
  },
  "handles": {
    "instagram": "@ragusabuzz",
    "tiktok": "@ragusabuzz"
  },
  "social": {
    "cta": "La storia completa: {url}",
    "hashtags": "#Ragusa #Sicilia #Cronaca #Notizie",
    "bed": "news"
  },
  "notes": "Local news for the Ragusa province, multilingual. Social is Italian-first, Instagram + TikTok only.",
  "feed": {
    "url": "https://ragusa.buzz/feed/v1/briefings?lang=it&limit=10",
    "items": "data",
    "fields": {
      "title": "title",
      "dek": "dek",
      "section": "sector.name",
      "date": "storyDate",
      "image": "imageUrl",
      "slug": "slug",
      "sources": "sourceCount",
      "languages": "languageCount"
    },
    "imageRewrite": {
      "match": "^.*?/api/assets/tenants/[0-9a-f-]+/",
      "replace": "https://ragusa.buzz/assets/"
    },
    "sections": {
      "Crime & Disasters": "Cronaca",
      "Economy & Markets": "Economia",
      "Energy & Climate": "Ambiente",
      "Geopolitics & Politics": "Politica",
      "Justice & Law": "Giustizia",
      "Media & Entertainment": "Spettacolo",
      "Society & Culture": "Società",
      "Sport": "Sport"
    },
    "storyUrl": "https://ragusa.buzz/#/b/{slug}?lang=it",
    "displayUrl": "ragusa.buzz"
  },
  "daily": {
    "slots": [
      "07:30",
      "13:00",
      "17:30",
      "20:00"
    ],
    "tz": "+02:00",
    "maxAgeHours": 48,
    "only": [
      "instagram_reel"
    ]
  },
  "music": {
    "prompt": "Instrumental news jingle for Ragusa Buzz, a Sicilian local news brand. Bright, warm and modern: a catchy four-note mandolin and marimba motif opens the track and returns, light Mediterranean percussion (tamburello, shaker), plucked bass, soft synth pad, 112 BPM, major key. Energetic but it sits under on-screen text. No vocals, a clean build and a confident button ending.",
    "seconds": 30
  }
}
